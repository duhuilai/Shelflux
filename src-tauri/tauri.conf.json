{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelflux",
  "version": "0.1.20",
  "identifier": "com.shelflux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shelflux",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "跨平台多协议连接管理工具",
    "longDescription": "Shelflux 是一款轻量化的跨平台连接管理工具，支持 SSH、SFTP、Telnet、Rlogin 等多种协议，提供服务器分组、标签页管理、文件传输、终端复用等现代化特性。",
    "copyright": "Copyright © 2026 Shelflux",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "perMachine"
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
